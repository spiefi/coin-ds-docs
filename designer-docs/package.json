{
  "name": "coin-designer-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/check-guides.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check-guides.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "verify": "npm run build && npm run test:browser",
    "coin:status": "node scripts/coin-components.mjs status",
    "coin:sync": "node scripts/coin-components.mjs sync",
    "coin:use": "node scripts/coin-components.mjs use"
  },
  "dependencies": {
    "@react-native-community/blur": "4.4.1",
    "jfs-components": "github:spiefi/coin-components#v0.1.78-636f3f5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-native": "0.80.2",
    "react-native-safe-area-context": "5.9.1",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0"
  }
}
