{
  "name": "coin-designer-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/check-guides.mjs && vite build && node agent-pack/scripts/trim-site.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "node agent-pack/scripts/packs.mjs",
    "check": "node scripts/check-guides.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "verify": "npm run build && npm run test:mcp && npm run test:browser",
    "coin:status": "node scripts/coin-components.mjs status",
    "coin:sync": "node scripts/coin-components.mjs sync",
    "coin:use": "node scripts/coin-components.mjs use",
    "build:agent-pack": "node agent-pack/scripts/build.mjs",
    "agent-pack:packs": "node agent-pack/scripts/packs.mjs",
    "agent-pack:copy": "node agent-pack/scripts/copy.mjs",
    "agent-pack:cross-check": "node agent-pack/scripts/cross-check.mjs",
    "agent-pack:pilot": "node agent-pack/pilot/run.mjs",
    "test:mcp": "node agent-pack/scripts/packs.mjs && node agent-pack/mcp/test.mjs",
    "mcp:serve": "node agent-pack/scripts/packs.mjs && node agent-pack/mcp/test.mjs --serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@react-native-community/blur": "4.4.1",
    "jfs-components": "github:spiefi/coin-components#v0.1.78-dbe0e02",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-native": "0.80.2",
    "react-native-safe-area-context": "5.9.1",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright-core": "1.63.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0"
  }
}
