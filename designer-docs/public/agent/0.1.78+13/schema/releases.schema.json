{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coin agent pack releases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "current",
    "releases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "current": {
      "type": "string"
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
