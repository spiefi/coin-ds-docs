{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coin agent pack pilot results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packVersion",
    "runAt",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packVersion": {
      "type": "string"
    },
    "runAt": {
      "type": "string",
      "format": "date-time"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "question",
        "expected",
        "withPack",
        "withoutPack"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "choose",
            "configure",
            "compose",
            "gap"
          ]
        },
        "question": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "withPack": {
          "$ref": "#/$defs/run"
        },
        "withoutPack": {
          "$ref": "#/$defs/run"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validAnswers",
        "required",
        "recommended",
        "settledBy"
      ],
      "properties": {
        "validAnswers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "settledBy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "read",
        "pass",
        "failed",
        "notes"
      ],
      "properties": {
        "answer": {
          "type": "string"
        },
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Pack files read; empty without the pack"
        },
        "pass": {
          "type": "boolean"
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Expectations it missed"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
